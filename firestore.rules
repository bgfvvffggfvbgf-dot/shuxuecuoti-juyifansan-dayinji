rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: wrongQuestions
    // Document ID: auto-generated
    // Fields:
    //   - uid: string (required) - Owner's UID
    //   - originalQuestion: map (required) - {text, imageUrl, options, answer, userAnswer}
    //   - knowledgePoint: string (required) - Core knowledge point
    //   - similarQuestions: list (required) - List of {question, answer, analysis}
    //   - createdAt: timestamp (required) - Creation time
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidWrongQuestion(data) {
      return data.uid is string &&
             data.originalQuestion is map &&
             data.knowledgePoint is string &&
             data.knowledgePoint.size() < 500 &&
             data.similarQuestions is list &&
             data.createdAt is timestamp;
    }

    match /wrongQuestions/{questionId} {
      allow read: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid) && isValidWrongQuestion(request.resource.data);
      allow update: if isOwner(resource.data.uid) && isOwner(request.resource.data.uid) && isValidWrongQuestion(request.resource.data);
      allow delete: if isOwner(resource.data.uid);
    }
    
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
